# ==============================================================================
# Git Ignore Configuration - Distributed GPU Task Offloading Midterm Project
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
*.dll

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
!.env.example

# PyInstaller / Build Artifacts / Executables
build/
dist/
build_installer/
*.spec
*.exe
*.msi
*.pkg
*.app

# Distribution / Packaging
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/

# Logs and databases
*.log
*.sqlite
*.sqlite3
*.tmp

# Dynamic Job Runtime Data & Transcoded Video Outputs
data/inputs/*
!data/inputs/.gitkeep
data/outputs/*
!data/outputs/.gitkeep
output/*
!output/.gitkeep
benchmarks/results/*
!benchmarks/results/.gitkeep

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
*~
.kilo/

# Operating System Metadata
.DS_Store
Thumbs.db
desktop.ini
