# ============================================
# Distributed GPU Task Offloading - Config
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real credentials.

# --- Worker Configuration ---
WORKER_HOST=0.0.0.0
WORKER_PORT=8000
AUTH_TOKEN=change-me-to-a-secure-random-string

# Storage paths (relative to worker root)
INPUT_DIRECTORY=./data/inputs
OUTPUT_DIRECTORY=./data/outputs
TEMP_DIRECTORY=./data/temp

# Resource limits
MAX_FILE_SIZE_MB=4096
MAX_JOB_DURATION_SECONDS=7200
MAX_QUEUE_SIZE=20
MAX_CONCURRENT_JOBS=1

# --- Client Configuration ---
# (Used when running the PyQt6 client)
CLIENT_WORKER_HOST=192.168.1.10
CLIENT_WORKER_PORT=8000
CLIENT_AUTH_TOKEN=change-me-to-a-secure-random-string
